# Stalwart client — local config (never commit; gitignored)

# Base URL of the Stalwart HTTP endpoint (no trailing slash). Used by the CLI
# and e2e tests when flags are not given.
STALWART_BASE_URL=

# Basic auth (username/password or app password). Preferred over token when set.
# STALWART_USERNAME=
# STALWART_PASSWORD=

# Bearer auth: OAuth access token or Stalwart API key (starts with `API_`).
# Used only when username/password are not set.
# STALWART_TOKEN=

# Optional default accountId (JMAP Id) used when an op does not pass one.
# STALWART_ACCOUNT_ID=

# Optional HTTP tuning.
# STALWART_TIMEOUT_MS=
# STALWART_RETRIES=
